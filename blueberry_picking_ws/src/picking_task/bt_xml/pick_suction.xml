<root BTCPP_format="4">
  <BehaviorTree ID="PickSuction">
    <RetryUntilSuccessful num_attempts="{max_retries}">
      <Sequence>
        <MoveToNamed target_name="home"/>
        <GlobalDetect cluster_pose="{cluster_pose}"/>
        <MoveToPose target="{cluster_pose}" offset_z="0.18"/>
        <RetryUntilSuccessful num_attempts="3">
          <FineDetect berry_pose="{berry_pose}"/>
        </RetryUntilSuccessful>
        <PlanSuction berry_pose="{berry_pose}" suction_plan="{suction_plan}"
                     pre_grasp="{pre_grasp}" grasp="{grasp}" post_grasp="{post_grasp}"/>
        <MoveToPose target="{pre_grasp}"/>
        <MoveToPose target="{grasp}"/>
        <ActivateSuction enable="true"/>
        <Delay delay_msec="300"><AlwaysSuccess/></Delay>
        <MoveToPose target="{post_grasp}"/>
        <MoveToPose target="{dump_pose}"/>
        <ActivateSuction enable="false"/>
      </Sequence>
    </RetryUntilSuccessful>
  </BehaviorTree>
</root>
