<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="contact_marker">
    <!-- static required: Harmonic set_pose corrupts Z on dynamic models -->
    <static>true</static>
    <link name="link">
      <visual name="visual">
        <geometry><sphere><radius>0.03</radius></sphere></geometry>
        <material>
          <ambient>1.0 0.15 0.1 1</ambient>
          <diffuse>1.0 0.2 0.05 1</diffuse>
          <emissive>0.8 0.1 0.0 1</emissive>
        </material>
      </visual>
    </link>
  </model>
</sdf>
