<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Wrist Orbbec Gemini 305 on Piper X flange (link6).
       Tape 2026-08-11: (0, -0.07, +0.04). Optical pitch Rx=0 until REFINE tip–berry GT. -->
  <link name="camera_wrist_link">
    <visual>
      <geometry><box size="0.04 0.02 0.02"/></geometry>
      <material name="black"><color rgba="0.1 0.1 0.1 1"/></material>
    </visual>
    <collision>
      <geometry><box size="0.04 0.02 0.02"/></geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/>
    </inertial>
  </link>

  <joint name="camera_wrist_joint" type="fixed">
    <parent link="link6"/>
    <child link="camera_wrist_link"/>
    <origin xyz="-0.012389519053219772 -0.059366042883212705 0.04" rpy="-0.350288 -0.132947 -0.113574"/>
  </joint>

  <link name="camera_wrist_color_optical_frame"/>
  <joint name="camera_wrist_color_optical_joint" type="fixed">
    <parent link="camera_wrist_link"/>
    <child link="camera_wrist_color_optical_frame"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="camera_wrist_depth_optical_frame"/>
  <joint name="camera_wrist_depth_optical_joint" type="fixed">
    <parent link="camera_wrist_link"/>
    <child link="camera_wrist_depth_optical_frame"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Classic Gazebo sensors (skipped in Gazebo Harmonic / use_gz) -->
  <xacro:unless value="$(arg use_gz)">
  <gazebo reference="camera_wrist_link">
    <sensor name="wrist_rgb_camera" type="camera">
      <always_on>true</always_on>
      <update_rate>15</update_rate>
      <camera>
        <horizontal_fov>1.047</horizontal_fov>
        <image><width>640</width><height>480</height><format>R8G8B8</format></image>
        <clip><near>0.05</near><far>3.0</far></clip>
      </camera>
      <plugin name="wrist_rgb" filename="libgazebo_ros_camera.so">
        <ros>
          <namespace>/camera_wrist</namespace>
          <remapping>~/image_raw:=color/image_raw</remapping>
          <remapping>~/camera_info:=color/camera_info</remapping>
        </ros>
        <frame_name>camera_wrist_color_optical_frame</frame_name>
      </plugin>
    </sensor>
    <sensor name="wrist_depth_camera" type="depth">
      <always_on>true</always_on>
      <update_rate>15</update_rate>
      <camera>
        <horizontal_fov>1.047</horizontal_fov>
        <image><width>640</width><height>480</height><format>R8G8B8</format></image>
        <clip><near>0.05</near><far>3.0</far></clip>
      </camera>
      <plugin name="wrist_depth" filename="libgazebo_ros_depth_camera.so">
        <ros>
          <namespace>/camera_wrist</namespace>
          <remapping>~/depth/image_raw:=depth/image_raw</remapping>
          <remapping>~/depth/camera_info:=depth/camera_info</remapping>
        </ros>
        <frame_name>camera_wrist_depth_optical_frame</frame_name>
      </plugin>
    </sensor>
  </gazebo>
  </xacro:unless>

  <!-- Gazebo Harmonic sensors (gz-sim; bridged to ROS in gz_sim.launch.py) -->
  <xacro:if value="$(arg use_gz)">
  <gazebo reference="camera_wrist_color_optical_frame">
    <sensor name="wrist_rgb" type="camera">
      <always_on>true</always_on>
      <update_rate>10</update_rate>
      <visualize>false</visualize>
      <topic>camera_wrist/color/image_raw</topic>
      <camera>
        <horizontal_fov>1.047</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>3.0</far>
        </clip>
      </camera>
    </sensor>
    <sensor name="wrist_depth" type="depth_camera">
      <always_on>true</always_on>
      <update_rate>10</update_rate>
      <visualize>false</visualize>
      <topic>camera_wrist/depth/image_raw</topic>
      <camera>
        <horizontal_fov>1.047</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
        </image>
        <clip>
          <near>0.05</near>
          <far>3.0</far>
        </clip>
      </camera>
    </sensor>
  </gazebo>
  </xacro:if>

</robot>
