# Native Ubuntu 22.04 reach stack — PBVS v2: Gemini 305 wrist + DaBai global
# See REFACTOR_SPEC_PBVS_VLM.md (hardware upgrade) + docs/REACH_PIPELINE.md
PIPER_X_DEV="/home/user/codes/piper_x_dev"
AGX_ARM_WS="${PIPER_X_DEV}/agx_arm_ros"
ORBBEC_WS="${PIPER_X_DEV}/OrbbecSDK_ROS2"              # Gemini 305 wrist (new SDK)
ORBBEC_WS_FIXED="${PIPER_X_DEV}/OrbbecSDK_ROS2_main"  # DaBai global (SDK v1)
PICKING_WS="${PIPER_X_DEV}/blueberry_picking_ws"

CAN_INTERFACE=can0
CAN_BITRATE=1000000
USBIP_CAN_BUSID=
USBIP_AUTO_ATTACH=false

ARM_CAN_PORT=can0
ARM_TYPE=piper_x
ARM_EFFECTOR=none
ARM_SPEED_PERCENT=20
ARM_AUTO_CONTROL_GATE=false
ARM_ENABLE_TIMEOUT=15.0
ARM_USE_RVIZ=false
ARM_TCP_OFFSET='[0.0,0.01883,0.06152,0.0,0.0,0.0]'

PICK_EE_LINK=tcp_link
PICK_CUP_CONTACT_OFFSET=0.015
PICK_CAMERA_MOUNT_Y=-0.06433722264599194
PICK_TCP_MOUNT_Z=0.06152
PICK_FLANGE_FRAME=link6

# Wrist: Orbbec Gemini 305
ORBBEC_LAUNCH=gemini305.launch.py
ORBBEC_USB_PORT=2-6
ORBBEC_SERIAL=CV2L761000W1
ORBBEC_CAMERA_NAME=camera_wrist
ORBBEC_DEPTH_REGISTRATION=true
ORBBEC_PUBLISH_TF=false
# Gemini 305 needs libuvc (unbind kernel uvcvideo first if needed)
ORBBEC_UVC_BACKEND=v4l2

# Wrist berry ranging: depth (RGB-D mask median) | mono (bbox size only).
DEPTH_POSE_SOURCE=depth

# Eye-in-hand: link6 -> camera_wrist_color_optical_frame (tape 2026-08-11)
# Rx=-22.32deg (20260812): trust depth_raw; offline lock Z 0.255→0.288 on session 123013.
CAMERA_MOUNT_FRAME=link6
CAMERA_MOUNT_TX=-0.006962964237819408
CAMERA_MOUNT_TY=-0.06433722264599194
CAMERA_MOUNT_TZ=0.04
CAMERA_MOUNT_RPY=-0.365480,0.013079,0.094110

# Global: Orbbec DaBai RGB-D (tape 2026-08-11; level look along +X)
ENABLE_FIXED_CAMERA=true
FIXED_CAMERA_NAME=camera_fixed
FIXED_CAMERA_FRAME=camera_fixed_color_optical_frame
FIXED_CAM_SERIAL=CC1N162021Z
FIXED_CAM_USB_PORT=1-8.4
FIXED_CAM_TX=-0.84
FIXED_CAM_TY=0.39
FIXED_CAM_TZ=0.18
FIXED_CAM_QX=0.5000
FIXED_CAM_QY=-0.5000
FIXED_CAM_QZ=0.5000
FIXED_CAM_QW=-0.5000

ENABLE_PERCEPTION=false
ENABLE_REACH_PERCEPTION=true
FINE_PERCEPTION=yolo_depth
ENABLE_FOUNDATION_POSE=false

ENABLE_TELEOP=false
TELEOP_LINEAR_SPEED=0.03
TELEOP_ANGULAR_SPEED=10.0

LOG_DIR="${PICKING_WS}/log/real_robot"
