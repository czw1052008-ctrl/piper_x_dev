# Native Ubuntu 22.04 reach stack — see docs/REACH_PIPELINE.md
PIPER_X_DEV="/home/user/codes/piper_x_dev"
AGX_ARM_WS="${PIPER_X_DEV}/agx_arm_ros"
ORBBEC_WS="${PIPER_X_DEV}/OrbbecSDK_ROS2_main"
PICKING_WS="${PIPER_X_DEV}/blueberry_picking_ws"

CAN_INTERFACE=can0
CAN_BITRATE=1000000
USBIP_CAN_BUSID=
USBIP_AUTO_ATTACH=false

ARM_CAN_PORT=can0
ARM_TYPE=piper_x
ARM_EFFECTOR=none
ARM_SPEED_PERCENT=20
ARM_AUTO_CONTROL_GATE=false
ARM_ENABLE_TIMEOUT=15.0
ARM_USE_RVIZ=false
ARM_TCP_OFFSET='[0.0,0.0,0.05,0.0,0.0,0.0]'

PICK_EE_LINK=tcp_link
PICK_CUP_CONTACT_OFFSET=0.04
PICK_CAMERA_MOUNT_Y=-0.08
PICK_TCP_MOUNT_Z=0.05
PICK_FLANGE_FRAME=link6

ORBBEC_LAUNCH=dabai.launch.py
ORBBEC_USB_PORT=
ORBBEC_CAMERA_NAME=camera_wrist
ORBBEC_DEPTH_REGISTRATION=true
ORBBEC_PUBLISH_TF=false
# v4l2 keeps kernel uvcvideo; libuvc needs unbind (scripts/orbbec_prep.sh --unbind-uvc)
ORBBEC_UVC_BACKEND=v4l2

CAMERA_MOUNT_FRAME=link6
CAMERA_MOUNT_TX=0.0
CAMERA_MOUNT_TY=-0.08
CAMERA_MOUNT_TZ=0.0
CAMERA_MOUNT_RPY=0.0,0.0,0.0

ENABLE_FIXED_CAMERA=true
FIXED_CAMERA_DEVICE=/dev/video0
FIXED_CAMERA_NAME=camera_fixed
FIXED_CAMERA_FRAME=camera_fixed_optical_frame
FIXED_CAM_TX=0.45
FIXED_CAM_TY=0.0
FIXED_CAM_TZ=0.55
FIXED_CAM_QX=0.0
FIXED_CAM_QY=0.7071
FIXED_CAM_QZ=0.0
FIXED_CAM_QW=0.7071

ENABLE_PERCEPTION=false
ENABLE_REACH_PERCEPTION=true
FINE_PERCEPTION=yolo_depth
ENABLE_FOUNDATION_POSE=false

ENABLE_TELEOP=false
TELEOP_LINEAR_SPEED=0.03
TELEOP_ANGULAR_SPEED=10.0

LOG_DIR="${PICKING_WS}/log/real_robot"
