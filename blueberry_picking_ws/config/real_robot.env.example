# Copy to config/real_robot.env and edit paths / defaults for your machine.
#   cp config/real_robot.env.example config/real_robot.env

# Workspace roots (under ~/piper_x_dev by default)
PIPER_X_DEV="${HOME}/piper_x_dev"
AGX_ARM_WS="${PIPER_X_DEV}/agx_arm_ros"
ORBBEC_WS="${PIPER_X_DEV}/OrbbecSDK_ROS2_main"
PICKING_WS="${PIPER_X_DEV}/blueberry_picking_ws"

# CAN (WSL2 + candleLight via usbipd)
CAN_INTERFACE=can0
CAN_BITRATE=1000000
# Windows usbipd BUSID for USB-CAN; leave empty to skip auto-attach
USBIP_CAN_BUSID=1-5
# Set true to run: powershell.exe usbipd attach --wsl --busid ...
USBIP_AUTO_ATTACH=false

# agx_arm_ctrl + MoveIt
ARM_CAN_PORT=can0
ARM_TYPE=piper_x
ARM_EFFECTOR=none
ARM_SPEED_PERCENT=20
ARM_AUTO_CONTROL_GATE=false
ARM_ENABLE_TIMEOUT=15.0
ARM_USE_RVIZ=false

# Orbbec DaBai (OrbbecSDK_ROS2 launch file name under orbbec_camera/launch/)
ORBBEC_LAUNCH=dabai.launch.py
ORBBEC_USB_PORT=1-3
ORBBEC_CAMERA_NAME=camera_wrist
ORBBEC_DEPTH_REGISTRATION=true
# false = we publish link6->optical (Z aligned with CS7); Orbbec default optical rpy would mis-map axes
ORBBEC_PUBLISH_TF=false

# Eye-in-hand: link6 (Piper X 坐标系7) -> camera_wrist_color_optical_frame
# 相机在 CS7 的 -Y 约 8cm；镜头光轴沿 CS7 +Z（与光学系 Z 同向，无额外旋转）
CAMERA_MOUNT_FRAME=link6
CAMERA_MOUNT_TX=0.0
CAMERA_MOUNT_TY=-0.08
CAMERA_MOUNT_TZ=0.0
CAMERA_MOUNT_RPY=0.0,0.0,0.0

# Perception (FoundationPose fine detector)
ENABLE_PERCEPTION=false
FINE_PERCEPTION=foundation_pose

# Teleop (foreground at end of bringup)
ENABLE_TELEOP=false
TELEOP_LINEAR_SPEED=0.03
TELEOP_ANGULAR_SPEED=10.0

# Logs written under ${PICKING_WS}/log/real_robot/
LOG_DIR="${PICKING_WS}/log/real_robot"
