# Copy to config/real_robot.env and edit paths / defaults for your machine.
#   cp config/real_robot.env.example config/real_robot.env

# Workspace roots (native Ubuntu — this machine)
PIPER_X_DEV="/home/user/codes/piper_x_dev"
AGX_ARM_WS="${PIPER_X_DEV}/agx_arm_ros"
ORBBEC_WS="${PIPER_X_DEV}/OrbbecSDK_ROS2"              # Gemini 305 wrist (new SDK)
ORBBEC_WS_FIXED="${PIPER_X_DEV}/OrbbecSDK_ROS2_main"  # DaBai global (SDK v1)
PICKING_WS="${PIPER_X_DEV}/blueberry_picking_ws"

# CAN (native Ubuntu gs_usb — do NOT use WSL usbipd)
CAN_INTERFACE=can0
CAN_BITRATE=1000000
USBIP_CAN_BUSID=
USBIP_AUTO_ATTACH=false

# agx_arm_ctrl + MoveIt
ARM_CAN_PORT=can0
ARM_TYPE=piper_x
ARM_EFFECTOR=none
ARM_SPEED_PERCENT=20
ARM_AUTO_CONTROL_GATE=false
ARM_ENABLE_TIMEOUT=15.0
ARM_USE_RVIZ=false
# No spaces — ros2 launch splits on whitespace inside unquoted values
ARM_TCP_OFFSET='[0.0,0.0,0.05,0.0,0.0,0.0]'

PICK_EE_LINK=tcp_link
PICK_CUP_CONTACT_OFFSET=0.015
PICK_CAMERA_MOUNT_Y=-0.08
PICK_TCP_MOUNT_Z=0.05
PICK_FLANGE_FRAME=link6

# Wrist: Orbbec Gemini 305 (leave serial empty to auto-detect)
ORBBEC_LAUNCH=gemini305.launch.py
ORBBEC_USB_PORT=
ORBBEC_SERIAL=
ORBBEC_CAMERA_NAME=camera_wrist
ORBBEC_DEPTH_REGISTRATION=true
ORBBEC_PUBLISH_TF=false
ORBBEC_UVC_BACKEND=v4l2

# Eye-in-hand: link6 -> camera_wrist_color_optical_frame
# Remeasure translation for Gemini mount; RPY starts at 0 until tip–berry GT pitch fit.
CAMERA_MOUNT_FRAME=link6
CAMERA_MOUNT_TX=0.0
CAMERA_MOUNT_TY=-0.08
CAMERA_MOUNT_TZ=-0.04
CAMERA_MOUNT_RPY=0.0,0.0,0.0

# Global: Orbbec DaBai RGB-D
ENABLE_FIXED_CAMERA=true
FIXED_CAMERA_NAME=camera_fixed
FIXED_CAMERA_FRAME=camera_fixed_color_optical_frame
FIXED_CAM_SERIAL=
FIXED_CAM_USB_PORT=
# Placeholder eye-to-hand — recalibrate after moving DaBai
FIXED_CAM_TX=0.60
FIXED_CAM_TY=0.33
FIXED_CAM_TZ=0.48
FIXED_CAM_QX=-0.3780
FIXED_CAM_QY=-0.8443
FIXED_CAM_QZ=0.3467
FIXED_CAM_QW=0.1552

# Perception (reach path: YOLO+depth topics, no FoundationPose)
ENABLE_PERCEPTION=false
ENABLE_REACH_PERCEPTION=true
FINE_PERCEPTION=yolo_depth
ENABLE_FOUNDATION_POSE=false

# Teleop
ENABLE_TELEOP=false
TELEOP_LINEAR_SPEED=0.03
TELEOP_ANGULAR_SPEED=10.0

LOG_DIR="${PICKING_WS}/log/real_robot"
